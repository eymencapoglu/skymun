# =================================================================
# SKYMUN Environment Variables Example Configuration
# Copy this file to .env or set these in your server environment.
# =================================================================

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skymun
DB_USER=your_db_username
DB_PASS=your_secure_db_password

# Administrator Authentication (Required for Production!)
# Set strong, unique credentials before deploying
ADMIN_USER=your_admin_username
ADMIN_PASS=your_strong_admin_password

# Conference Configuration
SITE_NAME=SKYMUN
SITE_MOTTO=Diplomacy for Tomorrow
SITE_URL=http://localhost
CONFERENCE_DATE=2026-12-20 09:00:00
CONTACT_EMAIL=contact@yourdomain.org

